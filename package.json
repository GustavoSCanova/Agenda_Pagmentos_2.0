{
  "name": "a-new-project",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm --workspace @a-new-project/web run dev",
    "dev:api": "npm --workspace @a-new-project/api run dev",
    "dev:api:tunnel": "cloudflared tunnel --url http://localhost:3001",
    "dev:mobile": "npm --workspace @a-new-project/mobile run start",
    "dev:mobile:tunnel": "npm --workspace @a-new-project/mobile run start -- --tunnel --clear",
    "build": "npm --workspace @a-new-project/shared run build && npm --workspace @a-new-project/api run build && npm --workspace @a-new-project/web run build",
    "lint": "npm run lint --workspaces --if-present"
  },
  "devDependencies": {
    "turbo": "^2.0.0"
  },
  "dependencies": {
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.24",
    "expo-sharing": "~14.0.8",
    "react": "^19.1.0",
    "react-native": "^0.81.5"
  }
}
